@baseUrl = http://localhost:1000

### Test the Server
GET {{baseUrl}}/

### Sign Up a New User
# This maps to the /sign-up route in your backend/routes/user.js file
POST {{baseUrl}}/api/v1/sign-up
Content-Type: application/json

{
    "username": "Chota",
    "email": "chota@example.com",
    "password": "chota123",
    "address": "123 Main St, New York, NY"
}

### Sign In user
POST {{baseUrl}}/api/v1/sign-in
Content-Type: application/json

{
    "username": "Chota",
    "password": "chota123"
}

### Sign In admin
POST {{baseUrl}}/api/v1/sign-in
Content-Type: application/json

{
    "username": "admin",
    "password": "admin123"
}

### Get User Information
# Replace the token and id with the values returned from the Sign In response above
GET {{baseUrl}}/api/v1/get-user-information
authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJuYW1lIjoiQ2hvdGEiLCJyb2xlIjoidXNlciIsImlhdCI6MTc4OTkyMzQzMiwiZXhwIjoxNzkyNTE1NDMyfQ.oe-3RIXI1_jvJwDJbEkue4gZgBRhNZ0725aRWYBaJaI
id: 6ab00feed20a57ac74f723ac

### Add book
POST {{baseUrl}}/api/v1/add-book
authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJuYW1lIjoiYWRtaW4iLCJyb2xlIjoiYWRtaW4iLCJpYXQiOjE3ODk5MjU5MzQsImV4cCI6MTc5MjUxNzkzNH0.0zkoI1nOBqLZgqM8FRKJ4c9rqrn2vLoiwez9uWfQZ1c
id: 6aaf1b82632ef57f83697dfb
Content-Type: application/json

{
    "url": "https://upload.wikimedia.org/wikipedia/commons/0/06/Atomic_habits.jpg",
    "title": "Atomic Habits",
    "author": "James Clear",
    "genre": "Self-Help",
    "price": 399,
    "stock": 100
}

